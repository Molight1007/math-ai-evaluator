# Math Evaluator - 容器运行时环境变量
# API 密钥由 Web 端"用户设置"写入 user_api_settings.json（已挂载），
# 评测时自动注入到容器环境变量，此处留空即可。
INTERN_S1_API_KEY=
INTERN_S1_BASE_URL=https://internlm-chat.intern-ai.org.cn/puyu/api/v1
INTERN_S1_MODEL=intern-s1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
